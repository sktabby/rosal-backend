# ── Database (Neon dev / any Postgres) ─────────────────────────────
# Get this from your Neon project dashboard -> Connection Details -> "Prisma" tab.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://REPLACE_ME:REPLACE_ME@REPLACE_ME.neon.tech/neondb?sslmode=require"

# ── App ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://10.0.2.2:4000"

# ── Auth / JWT ──────────────────────────────────────────────────────
JWT_SECRET="REPLACE_ME"
JWT_EXPIRES_IN="12h"
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# ── Captcha (admin user creation) ───────────────────────────────────
# Server-side reCAPTCHA secret from https://www.google.com/recaptcha/admin
# Required — the app refuses to boot without it.
RECAPTCHA_SECRET_KEY="REPLACE_ME"

# ── Email (OTP + new-user credentials) ─────────────────────────────
# Resend (HTTPS API) is used when RESEND_API_KEY is set — required on Render,
# whose free instances block outbound SMTP ports (25/465/587). Leave it empty
# to fall back to the SMTP settings below (fine for local dev).
RESEND_API_KEY=""
# Sender address used by whichever transport is active. Until you verify a
# domain in Resend, this must be onboarding@resend.dev
MAIL_FROM="Rosal Safety OMS <onboarding@resend.dev>"

# SMTP fallback — used only when RESEND_API_KEY is empty
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="REPLACE_ME"
SMTP_PASS="REPLACE_ME"
SMTP_FROM="Rosal Safety OMS <REPLACE_ME>"

# ── SMS (OTP) ───────────────────────────────────────────────────────
# Twilio used as the default provider — swap in sms.service.ts if you use another
TWILIO_ACCOUNT_SID="REPLACE_ME"
TWILIO_AUTH_TOKEN="REPLACE_ME"
TWILIO_FROM_NUMBER="REPLACE_ME"

# ── Object storage (Bill/Invoice PDFs, external attachments) ───────
# Cloudflare R2 (S3-compatible) recommended — Backblaze B2 also works with the same client
S3_ENDPOINT="https://REPLACE_ME.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="rosal-oms-files"
S3_ACCESS_KEY_ID="REPLACE_ME"
S3_SECRET_ACCESS_KEY="REPLACE_ME"
S3_PUBLIC_BASE_URL="https://files.rosalsafety.in"

# ── LOCAL DEV ONLY: OTP console shortcut ───────────────────────────
# When true, the backend prints the login OTP to the terminal instead of
# emailing/texting it — useful while Resend is still in sandbox mode.
# Double-gated: also requires NODE_ENV to NOT be 'production'.
# NEVER set this in Render / any deployed environment.
OTP_DEV_MODE=false
