# ── Database (Neon dev / any Postgres) ─────────────────────────────
# Get this from your Neon project dashboard -> Connection Details -> "Prisma" tab.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://REPLACE_ME:REPLACE_ME@REPLACE_ME.neon.tech/neondb?sslmode=require"

# ── App ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://10.0.2.2:4000"

# ── Auth / JWT ──────────────────────────────────────────────────────
JWT_SECRET="REPLACE_ME"
JWT_EXPIRES_IN="12h"
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# ── Email (OTP + new-user credentials) ─────────────────────────────
# Any SMTP provider works (e.g. SendGrid, Postmark, Gmail App Password for dev)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="REPLACE_ME"
SMTP_PASS="REPLACE_ME"
SMTP_FROM="Rosal Safety OMS <REPLACE_ME>"

# ── SMS (OTP) ───────────────────────────────────────────────────────
# Twilio used as the default provider — swap in sms.service.ts if you use another
TWILIO_ACCOUNT_SID="REPLACE_ME"
TWILIO_AUTH_TOKEN="REPLACE_ME"
TWILIO_FROM_NUMBER="REPLACE_ME"

# ── Object storage (Bill/Invoice PDFs, external attachments) ───────
# Cloudflare R2 (S3-compatible) recommended — Backblaze B2 also works with the same client
S3_ENDPOINT="https://REPLACE_ME.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="rosal-oms-files"
S3_ACCESS_KEY_ID="REPLACE_ME"
S3_SECRET_ACCESS_KEY="REPLACE_ME"
S3_PUBLIC_BASE_URL="https://files.rosalsafety.in"
